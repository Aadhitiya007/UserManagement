# Server Configuration
PORT=5000

# Database
MONGO_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/<dbname>

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here

# Initial Admin User Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# AWS S3 Configuration (Optional for Cloud Image Storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET_NAME=your_bucket_name

# Client & Frontend URLs
CLIENT_URL=https://shopiee-test.vercel.app
FRONTEND_URL=https://shopiee-test.vercel.app

# Payment Webhook Secret
PAYMENT_WEBHOOK_SECRET=your_payment_webhook_secret

# Production Email Delivery (Gmail SMTP or any SMTP provider)
# For Gmail, generate a 16-character App Password at: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password
EMAIL_FROM="Shopiee Orders" <your_email@gmail.com>
NODE_ENV=production

